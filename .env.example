# Copiá este archivo a .env y completá tus claves. NUNCA subas .env al repo.

# Proveedor del LLM: "anthropic", "openai" o "gemini"
LLM_PROVIDER=gemini

# Si usás Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Si usás OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Si usás Gemini (clave de Google AI Studio)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Archivo SQLite donde se guarda la memoria (checkpointer)
SQLITE_PATH=checkpoints.sqlite
